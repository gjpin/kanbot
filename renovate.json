{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigestsToSemver",
    "docker:pinDigests",
    ":semanticCommits"
  ],
  "timezone": "UTC",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "One PR for all non-major updates per ecosystem.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "{{manager}} non-major",
      "groupSlug": "{{manager}}-non-major"
    },
    {
      "description": "The PostgreSQL image (compose.yaml, which CI uses too) in a PR of its own: a database upgrade deserves its own review.",
      "matchDepNames": ["postgres"],
      "groupName": "postgres",
      "groupSlug": "postgres"
    },
    {
      "description": "The Rust toolchain, Flutter and Dart SDKs get their own PRs.",
      "matchDepNames": ["rust", "flutter", "dart"],
      "groupName": null,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Ships inside the Flutter SDK (includeBuild), not a registry. It updates with Flutter.",
      "matchManagers": ["gradle"],
      "matchDepNames": ["dev.flutter.flutter-plugin-loader"],
      "enabled": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions in workflow env: blocks, marked with a `# renovate:` comment; an image may carry its digest (`tag@sha256:...`).",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[A-Z_]+: \"(?<currentValue>[^\"@]+)\"",
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[A-Z_]+: \"(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[0-9a-f]{64})\""
      ]
    },
    {
      "customType": "regex",
      "description": "Cargo tools installed by taiki-e/install-action (`tool: <crate>@<version>`).",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "tool: (?<depName>[a-z0-9_-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "crate"
    },
    {
      "customType": "regex",
      "description": "The pinned Rust toolchain, and the crate's rust-version kept equal to it (same dep, same PR).",
      "managerFilePatterns": ["/(^|/)rust-toolchain\\.toml$/", "/^backend/Cargo\\.toml$/", "/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "channel = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "rust-version = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"",
        "ARG RUST_TOOLCHAIN=(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "rust",
      "datasourceTemplate": "github-releases",
      "packageNameTemplate": "rust-lang/rust"
    },
    {
      "customType": "regex",
      "description": "Tools the dev container installs (`# renovate:` above `ARG NAME=version`). The checksum or commit next to a version is not updated: until someone updates it by hand, building the container fails its check (CI does not build it), so an unverified download never gets in.",
      "managerFilePatterns": ["/^\\.devcontainer/Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+ARG [A-Z0-9_]+=(?<currentValue>\\S+)"
      ]
    },
    {
      "customType": "regex",
      "description": "The protoc that regenerates the OpenShell client. Its checksums are not updated: until someone updates them by hand, the script refuses the download, and the openshell-api CI job, which runs it, fails.",
      "managerFilePatterns": ["/^backend/openshell-api/codegen/fetch-protoc\\.sh$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+version=(?<currentValue>\\S+)"
      ],
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ]
}
