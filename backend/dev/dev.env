# Backend settings for the local stack (compose.yaml). DEVELOPMENT ONLY: no
# real secrets. From backend/:
#
#   set -a; . dev/dev.env; set +a
#   cargo run
#
# Needs `sh dev/auth-setup.sh`, `docker compose up -d` and
# `127.0.0.1 auth.kanbot.internal` in /etc/hosts.
DATABASE_URL=postgres://kanbot:kanbot@127.0.0.1:5432/kanbot
OIDC_ISSUER=https://auth.kanbot.internal:9443
OIDC_AUDIENCE=kanbot-api
OIDC_ROLES_CLAIM=groups
OIDC_ADMIN_ROLE=kanbot-admin
OIDC_USER_ROLE=kanbot-user
OIDC_CA_FILE=dev/.generated/ca.crt
