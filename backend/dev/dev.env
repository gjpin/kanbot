# Backend settings for the local stack (compose.yaml). DEVELOPMENT ONLY: no
# real secrets. From backend/:
#
#   set -a; . dev/dev.env; set +a
#   cargo run
#
# Needs `sh dev/auth-setup.sh`, `docker compose up -d` and
# `127.0.0.1 auth.kanbot.internal` in /etc/hosts.
DATABASE_URL=postgres://kanbot:kanbot@127.0.0.1:5432/kanbot
OIDC_ISSUER=https://auth.kanbot.internal:9443
OIDC_AUDIENCE=kanbot-api
OIDC_ROLES_CLAIM=groups
OIDC_ADMIN_ROLE=kanbot-admin
OIDC_USER_ROLE=kanbot-user
OIDC_CA_FILE=dev/.generated/ca.crt
# The login flow (sessions). The client secret is the documented dev-only
# one in dev/authelia/configuration.yml; the session key is dev-only too.
OIDC_CLIENT_ID=kanbot
OIDC_CLIENT_SECRET=kanbot-dev-client-secret
OIDC_SCOPES='openid profile email groups offline_access'
PUBLIC_URL=http://localhost:3000
SESSION_ENCRYPTION_KEYS=dev1:czk2opcn1a0nCDWcUfEyr+CQ1uFYDiise9vVTemD1EY=
# Deployer authorization policies (docs/authorization.md).
AUTHZ_POLICY_FILE=dev/policies.cedar
