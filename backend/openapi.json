{
  "openapi": "3.1.0",
  "info": {
    "title": "kanbot API",
    "description": "Errors are RFC 9457 problem details (`application/problem+json`) with a stable `code`.",
    "version": "0.1.0"
  },
  "paths": {
    "/auth/login": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Starts a sign-in: redirects the browser to the identity provider.",
        "description": "The web app navigates here; native apps open it in the system browser\nwith their redirect URI and PKCE challenge.",
        "operationId": "login",
        "parameters": [
          {
            "name": "platform",
            "in": "query",
            "description": "`web` or `native`.",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Which app signs in.",
              "enum": [
                "web",
                "native"
              ]
            }
          },
          {
            "name": "redirect_uri",
            "in": "query",
            "description": "Native only: `dev.sideral.kanbot:/auth/done`, or\n`http://127.0.0.1:<port>/auth/done` on Windows and Linux.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code_challenge",
            "in": "query",
            "description": "Native only: the S256 PKCE challenge of the app's verifier.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "code_challenge_method",
            "in": "query",
            "description": "Native only: `S256`.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "303": {
            "description": "To the identity provider's sign-in page.",
            "headers": {
              "Location": {
                "schema": {
                  "type": "string"
                },
                "description": "The authorization URL."
              }
            }
          },
          "400": {
            "description": "Unknown or malformed parameters.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Parameters that do not fit the platform, or a redirect URI that is not the app's.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "The identity provider has not been discovered yet.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness: the process is up and serving HTTP.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "The server is up.",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "tags": [
          "users"
        ],
        "summary": "The signed-in user.",
        "operationId": "me",
        "responses": {
          "200": {
            "description": "The signed-in user.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "No valid credentials.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The user has no kanbot role (`forbidden`) or is disabled (`account_disabled`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/me/preferences": {
      "put": {
        "tags": [
          "users"
        ],
        "summary": "Updates the signed-in user's preferences.",
        "operationId": "update_preferences",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Preferences"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "The user, with the new preferences.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "No valid credentials.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The user has no kanbot role (`forbidden`) or is disabled (`account_disabled`).",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The body is not valid preferences.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
    "/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness: the database is reachable, every migration has been applied,\nand the identity provider's signing keys have been loaded. Until\n`kanbot-backend migrate` has run, the old schema is in place and\nrequests could fail; until the keys load, no request can be\nauthenticated. Either way the instance takes no traffic.",
        "operationId": "ready",
        "responses": {
          "200": {
            "description": "Ready to take traffic."
          },
          "503": {
            "description": "Not ready: the database is unreachable, migrations are pending, or the identity provider's keys have not loaded.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ErrorCode": {
        "type": "string",
        "description": "Stable, machine-readable error codes. Clients depend on these strings:\nadd new codes, but never rename or reuse one.",
        "enum": [
          "bad_request",
          "unauthorized",
          "forbidden",
          "not_found",
          "method_not_allowed",
          "conflict",
          "payload_too_large",
          "unsupported_media_type",
          "validation_failed",
          "rate_limited",
          "internal",
          "unavailable",
          "account_disabled",
          "telemetry_disabled"
        ]
      },
      "FieldError": {
        "type": "object",
        "description": "One invalid field of a request.",
        "required": [
          "pointer",
          "code"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Why it is invalid, as a stable `snake_case` code (`too_long`,\n`required`, ...). Never the invalid value itself."
          },
          "pointer": {
            "type": "string",
            "description": "JSON Pointer (RFC 6901) to the field in the request body, for example\n`/title` or `/labels/2`."
          }
        }
      },
      "Me": {
        "type": "object",
        "description": "The signed-in user.",
        "required": [
          "id",
          "platform_role",
          "telemetry_opt_in"
        ],
        "properties": {
          "display_name": {
            "type": [
              "string",
              "null"
            ],
            "description": "From the identity provider (`name`, else `preferred_username`)."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "platform_role": {
            "$ref": "#/components/schemas/PlatformRoleDto"
          },
          "telemetry_opt_in": {
            "type": "boolean",
            "description": "Whether the app may send telemetry. Off until the user opts in."
          }
        }
      },
      "PlatformRoleDto": {
        "type": "string",
        "description": "What the user may do across the whole instance.",
        "enum": [
          "admin",
          "user"
        ]
      },
      "Preferences": {
        "type": "object",
        "description": "The user's preferences.",
        "required": [
          "telemetry_opt_in"
        ],
        "properties": {
          "telemetry_opt_in": {
            "type": "boolean",
            "description": "Allow the app to send telemetry."
          }
        },
        "additionalProperties": false
      },
      "Problem": {
        "type": "object",
        "description": "A problem details body (RFC 9457), with the `code` and `errors`\nextension members.",
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "errors": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "description": "The invalid fields of a `validation_failed` problem."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "Always the status of the response that carries the problem.",
            "minimum": 0
          },
          "title": {
            "type": "string"
          },
          "trace_id": {
            "type": [
              "string",
              "null"
            ],
            "description": "The W3C trace id of the request (32 hex digits), when telemetry is\non. Lets support find the request's trace and logs.",
            "example": "4bf92f3577b34da6a3ce929d0e0e4736"
          },
          "type": {
            "type": "string",
            "description": "`urn:kanbot:problem:<code>`.",
            "example": "urn:kanbot:problem:not_found"
          }
        }
      }
    },
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "An access token from the deployment's OIDC identity provider."
      }
    }
  }
}
