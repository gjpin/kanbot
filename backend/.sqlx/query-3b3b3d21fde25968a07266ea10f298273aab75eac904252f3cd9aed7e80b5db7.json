  "query": "\n        SELECT u.id, u.display_name, m.role, m.source\n        FROM team_members m\n        JOIN users u ON u.id = m.user_id\n        WHERE m.team_id = $1\n        ORDER BY m.role = 'maintainer' DESC, u.display_name NULLS LAST, u.id\n        ",
