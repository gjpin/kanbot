  "query": "\n        UPDATE teams\n        SET slug = COALESCE($2, slug),\n            name = COALESCE($3, name),\n            idp_group = CASE WHEN $4 THEN $5 ELSE idp_group END,\n            updated_at = now()\n        WHERE id = $1\n        RETURNING id, slug, name, idp_group\n        ",
