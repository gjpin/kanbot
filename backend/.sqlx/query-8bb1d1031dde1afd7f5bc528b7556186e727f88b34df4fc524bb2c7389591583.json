  "query": "\n        UPDATE organizations\n        SET slug = COALESCE($2, slug), name = COALESCE($3, name), updated_at = now()\n        WHERE id = $1 AND (slug <> COALESCE($2, slug) OR name <> COALESCE($3, name))\n        RETURNING id, slug, name, openshell_workspace\n        ",
