{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT t.id, t.slug\n        FROM teams t\n        WHERE ($2\n               OR EXISTS (SELECT 1 FROM organization_admins WHERE user_id = $1)\n               OR t.id IN (SELECT team_id FROM team_members WHERE user_id = $1))\n          AND ($3::text IS NULL OR t.slug > $3)\n        ORDER BY t.slug\n        LIMIT $4\n        ",
