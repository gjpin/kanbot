  "query": "\n        SELECT t.id, t.slug, t.name, t.idp_group, l.access\n        FROM organization_teams l\n        JOIN teams t ON t.id = l.team_id\n        WHERE l.organization_id = $1 AND t.slug > COALESCE($2::text, '')\n        ORDER BY t.slug\n        LIMIT $3\n        ",
