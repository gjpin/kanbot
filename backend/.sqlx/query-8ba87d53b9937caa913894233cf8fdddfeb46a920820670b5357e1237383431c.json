{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            a.id,\n            to_char(a.at AT TIME ZONE 'UTC', 'YYYY-MM-DD\"T\"HH24:MI:SS.US\"Z\"') AS \"at!\",\n            a.actor_user_id,\n            u.display_name,\n            a.action,\n            a.target_type,\n            a.target_id,\n            a.policy_ids,\n            a.details::text AS \"details!\"\n        FROM audit_log a\n        JOIN users u ON u.id = a.actor_user_id\n        WHERE $1::bigint IS NULL OR a.id < $1\n        ORDER BY a.id DESC\n        LIMIT $2\n        ",
