  "query": "\n        SELECT u.id, u.display_name, u.disabled_at IS NOT NULL AS \"disabled!\"\n        FROM organization_admins a\n        JOIN users u ON u.id = a.user_id\n        WHERE a.organization_id = $1\n        ORDER BY u.display_name NULLS LAST, u.id\n        ",
